# Copy to .env and fill in.
# Local:      postgresql://postgres:postgres@localhost:5432/tournament_maker
# Production: the connection string from your Neon project
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tournament_maker"

# Neon Auth (email-code sign-in). Base URL from `neon neon-auth status`.
NEON_AUTH_BASE_URL="https://<endpoint>.neonauth.<region>.aws.neon.tech/neondb/auth"
# Any random string of 32+ characters, e.g. `openssl rand -base64 32`
NEON_AUTH_COOKIE_SECRET=""

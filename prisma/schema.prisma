generator client {
  provider   = "prisma-client-js"
  // No native query engine: queries go through a JS driver adapter (Neon),
  // which is what Cloudflare Workers needs and keeps the bundle small.
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL") // pooled: used by the app
  directUrl = env("DATABASE_URL_UNPOOLED") // direct: used by db push / migrations
}

enum TournamentFormat {
  SINGLE_ELIMINATION
  ROUND_ROBIN
  DOUBLE_ELIMINATION
  SWISS
}

enum MatchBracket {
  WINNERS // also used for single elimination, round robin and Swiss
  LOSERS // double elimination only
  GRAND_FINAL // double elimination only (round 2 = bracket reset)
}

enum TournamentStatus {
  DRAFT // created, editing participants
  IN_PROGRESS // bracket generated, matches being played
  COMPLETED
}

enum MatchStatus {
  PENDING // waiting for participants
  READY // both participants known
  COMPLETED
}

model Tournament {
  id           String           @id @default(cuid())
  name         String
  game         String?
  format       TournamentFormat @default(SINGLE_ELIMINATION)
  status       TournamentStatus @default(DRAFT)
  // Neon Auth user id (neon_auth schema). Only the owner can manage the tournament.
  ownerId      String?
  participants Participant[]
  matches      Match[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([ownerId])
}

model Participant {
  id           String     @id @default(cuid())
  name         String
  seed         Int
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, seed])
}

model Match {
  id             String      @id @default(cuid())
  tournamentId   String
  tournament     Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  bracket        MatchBracket @default(WINNERS)
  round          Int
  position       Int
  participant1Id String?
  participant2Id String?
  score1         Int?
  score2         Int?
  winnerId       String?
  status         MatchStatus @default(PENDING)
  // A bye: one slot will never be filled, so whoever arrives advances automatically
  bye                Boolean @default(false)
  // Elimination brackets: where the winner (and, in double elimination, the loser) goes next
  nextMatchId        String?
  nextMatchSlot      Int? // 1 or 2
  loserNextMatchId   String?
  loserNextMatchSlot Int?

  @@unique([tournamentId, bracket, round, position])
  @@index([tournamentId])
}
